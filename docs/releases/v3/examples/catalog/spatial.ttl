@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Spatial coverage of the catalog of the City of Zurich:
# IRI reference to the LINDAS municipality (BFS number 261).
<https://opendata.zurich/opendata>
  a dcat:Catalog ;
  dct:spatial <https://ld.admin.ch/municipality/261> .

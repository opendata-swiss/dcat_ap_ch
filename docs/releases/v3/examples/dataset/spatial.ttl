@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .

# Spatial coverage of a dataset about the City of Zurich:
# - as IRI reference to the LINDAS municipality (BFS number 261)
# - as dct:Location with bounding box and centroid (WGS 84, lon/lat)
<https://opendata.zurich/opendata/1234>
  a dcat:Dataset ;
  dct:spatial <https://ld.admin.ch/municipality/261> , [
    a dct:Location ;
    dcat:bbox """POLYGON((
          8.448 47.320 , 8.625 47.320 ,
          8.625 47.435 , 8.448 47.435 ,
          8.448 47.320
        ))"""^^gsp:wktLiteral ;
    dcat:centroid "POINT(8.5307 47.3830)"^^gsp:wktLiteral
  ] .
